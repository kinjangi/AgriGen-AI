{
  "name": "agrigen-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "venv313\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000 --app-dir backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "powershell -ExecutionPolicy Bypass -File .\\run_local.ps1",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
