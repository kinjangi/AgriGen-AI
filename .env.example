PROJECT_NAME="AgriGen AI"
VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=True

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrigen_db
# DATABASE_URL is constructed automatically if omitted, or can be explicitly set:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrigen_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# API Keys Configuration
# Use real provider keys only; placeholders and URLs will be rejected.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPEN_METEO_API_KEY=""

